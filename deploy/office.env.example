# Settings for the office.
#
#   local:   copy to .env in the project root (./officectl setup does this)
#   systemd: copy to /etc/digital-office.env and chmod 600
#
# Never commit the real file - .env is gitignored.

# ---- backend -------------------------------------------------------------
# agentsdk (default) | api | mock
OFFICE_BACKEND=agentsdk

# Credentials. The Agent SDK uses whichever of these the environment holds.
#   Subscription: generate on a machine you can log in on, with `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=
#   Pay-as-you-go API credits (also required for OFFICE_BACKEND=api)
# ANTHROPIC_API_KEY=

# ---- who the office works for --------------------------------------------
# Substituted into every persona wherever it writes {principal}. One line,
# written as the end of the sentence "a digital office that works for ...".
OFFICE_PRINCIPAL=one person: your principal. Assume competence and skip basic explanation

# ---- network -------------------------------------------------------------
# Keep this on loopback and let nginx/Caddy terminate TLS in front of it.
OFFICE_HOST=127.0.0.1
OFFICE_PORT=8765
# Shared secret required on every request. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OFFICE_TOKEN=change-me

# ---- cost controls -------------------------------------------------------
OFFICE_DAILY_BUDGET_USD=2.00
OFFICE_TASK_BUDGET_USD=0.15
OFFICE_MODEL_SMART=sonnet
OFFICE_MODEL_CHEAP=haiku
OFFICE_MAX_TOOL_RESULT=4000

# ---- comms desk (optional) ----------------------------------------------
# SLACK_TOKEN=xoxp-...
# SLACK_CHANNELS=C012ABCDEF,C034GHIJKL
# MAIL_HOST=imap.gmail.com
# MAIL_USER=you@example.com
# MAIL_PASSWORD=app-specific-password
# MAIL_FOLDER=INBOX
