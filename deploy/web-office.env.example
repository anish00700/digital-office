# The web studio - a second office alongside the main one.
#
#   OFFICE_ENV=.env.web ./officectl start     (stop / status / logs the same way)
#   http://127.0.0.1:8766
#
# Your credential is NOT here. Shared settings stay in .env and are read after
# this file, so nothing secret has to be copied between offices.

OFFICE_PACK=web
OFFICE_PORT=8766
OFFICE_DATA_DIR=data/web
OFFICE_WORKSPACE=workspace/web
OFFICE_PRINCIPAL=one person: your principal, who is having a web product built. They can read code and judge a design, so skip beginner explanation and lead with the decision

# Building a page takes many tool calls. The $0.15 default is sized for a
# question, not a build: it would stop an agent halfway and mark the task
# partial. A ceiling, not a target.
OFFICE_TASK_BUDGET_USD=1.50
OFFICE_DAILY_BUDGET_USD=0

# Two offices share one subscription window, so this one takes fewer slots.
OFFICE_MAX_CONCURRENT=2
